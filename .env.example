# 系統試算表 ID (主資料庫) - 請填入您的 Google 試算表 ID
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Apps Script 專案 ID - 請填入您的 Apps Script 專案 ID
SCRIPT_ID=your_script_id_here

# 部署 Web App URL - 請填入 Apps Script 部署後的 Web App URL
WEB_APP_URL=https://script.google.com/macros/s/your_deployment_id/exec

# 環境識別
ENV=development
